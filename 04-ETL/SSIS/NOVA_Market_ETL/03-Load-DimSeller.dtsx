      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{55243E60-4806-418B-9E2C-693FE1AB8592}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimSeller&#xA;    WHERE SellerKey &lt;&gt; 0&#xA;)&#xA;BEGIN&#xA;    THROW 51043, 'DimSeller load aborted: business rows already exist. Run the centralized full-refresh reset first.', 1;&#xA;END;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimSeller&#xA;    WHERE SellerKey = 0&#xA;)&#xA;BEGIN&#xA;    DELETE FROM dwh.DimSeller&#xA;    WHERE SellerKey = 0;&#xA;END;&#xA;&#xA;SET IDENTITY_INSERT dwh.DimSeller ON;&#xA;&#xA;INSERT INTO dwh.DimSeller&#xA;(&#xA;    SellerKey,&#xA;    SellerID,&#xA;    GeographyKey,&#xA;    SourceZipCodePrefix,&#xA;    SourceCityName,&#xA;    SourceStateCode,&#xA;    CityMismatchFlag,&#xA;    StateMismatchFlag&#xA;)&#xA;VALUES&#xA;(&#xA;    0,&#xA;    NULL,&#xA;    0,&#xA;    NULL,&#xA;    N'Unknown',&#xA;    NULL,&#xA;    0,&#xA;    0&#xA;);&#xA;&#xA;SET IDENTITY_INSERT dwh.DimSeller OFF;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
