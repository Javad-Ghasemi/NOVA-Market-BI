            <component
              refId="Package\DFT - Load DimSeller\SRC - Sellers"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - Sellers"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    s.seller_id AS SellerID,
    s.seller_zip_code_prefix AS ZipCodePrefix,
    s.seller_city AS SourceCityName,
    s.seller_state AS SourceStateCode,

    REPLACE(
        REPLACE(
            REPLACE(
                LOWER(LTRIM(RTRIM(s.seller_city)))
                    COLLATE Latin1_General_100_CI_AI,
                N' ',
                N''
            ),
            N'-',
            N''
        ),
        N'''',
        N''
    ) AS SellerCityMatchKey,

    CASE
        WHEN g.ZipCodePrefix IS NULL THEN CAST(1 AS BIT)
        WHEN g.CityName IS NULL THEN CAST(1 AS BIT)

        WHEN
            REPLACE(
                REPLACE(
                    REPLACE(
                        LOWER(LTRIM(RTRIM(s.seller_city)))
                            COLLATE Latin1_General_100_CI_AI,
                        N' ',
                        N''
                    ),
                    N'-',
                    N''
                ),
                N'''',
                N''
            )
            &lt;&gt;
            REPLACE(
                REPLACE(
                    REPLACE(
                        LOWER(LTRIM(RTRIM(g.CityName)))
                            COLLATE Latin1_General_100_CI_AI,
                        N' ',
                        N''
                    ),
                    N'-',
                    N''
                ),
                N'''',
                N''
            )
        THEN CAST(1 AS BIT)

        ELSE CAST(0 AS BIT)
    END AS SqlCityMismatchFlag,

    CASE
        WHEN g.ZipCodePrefix IS NULL THEN CAST(1 AS BIT)

        WHEN s.seller_state COLLATE Latin1_General_100_CI_AI
             &lt;&gt; g.StateCode COLLATE Latin1_General_100_CI_AI
        THEN CAST(1 AS BIT)

        ELSE CAST(0 AS BIT)
    END AS SqlStateMismatchFlag

FROM stg.sellers s
LEFT JOIN conformed.Geography g
    ON s.seller_zip_code_prefix = g.ZipCodePrefix;</property>
                <property
