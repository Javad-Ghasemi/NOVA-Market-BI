    <DTS:Executable
      DTS:refId="Package\SQL - Preflight Full Refresh"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BAF8AA9D-9FFE-454B-A181-532A5E530F4B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Preflight Full Refresh"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{55243E60-4806-418B-9E2C-693FE1AB8592}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;/* =========================================================&#xA;   MASTER FULL-REFRESH PREFLIGHT&#xA;&#xA;   Purpose:&#xA;   Fail before destructive reset if critical prerequisites&#xA;   are not ready.&#xA;   ========================================================= */&#xA;&#xA;&#xA;/* ---------------------------------------------------------&#xA;   1. Database safety&#xA;   --------------------------------------------------------- */&#xA;&#xA;IF DB_NAME() &lt;&gt; N'NOVA_Market'&#xA;BEGIN&#xA;    THROW 51050,&#xA;        'Master preflight failed: current database is not NOVA_Market.',&#xA;        1;&#xA;END;&#xA;&#xA;&#xA;/* ---------------------------------------------------------&#xA;   2. Required static date dimension&#xA;   --------------------------------------------------------- */&#xA;&#xA;IF OBJECT_ID(N'dwh.DimDate', N'U') IS NULL&#xA;BEGIN&#xA;    THROW 51051,&#xA;        'Master preflight failed: dwh.DimDate does not exist.',&#xA;        1;&#xA;END;&#xA;&#xA;IF&#xA;(&#xA;    SELECT COUNT(*)&#xA;    FROM dwh.DimDate&#xA;    WHERE DateKey = 0&#xA;) &lt;&gt; 1&#xA;BEGIN&#xA;    THROW 51052,&#xA;        'Master preflight failed: DimDate must contain exactly one Unknown member with DateKey = 0.',&#xA;        1;&#xA;END;&#xA;&#xA;&#xA;/* ---------------------------------------------------------&#xA;   3. Required conformed / metadata prerequisites&#xA;   --------------------------------------------------------- */&#xA;&#xA;IF OBJECT_ID(N'conformed.Geography', N'U') IS NULL&#xA;BEGIN&#xA;    THROW 51053,&#xA;        'Master preflight failed: conformed.Geography does not exist.',&#xA;        1;&#xA;END;&#xA;&#xA;IF OBJECT_ID(N'conformed.Customer', N'U') IS NULL&#xA;BEGIN&#xA;    THROW 51054,&#xA;        'Master preflight failed: conformed.Customer does not exist.',&#xA;        1;&#xA;END;&#xA;&#xA;IF OBJECT_ID(N'conformed.ProductCategory', N'U') IS NULL&#xA;BEGIN&#xA;    THROW 51055,&#xA;        'Master preflight failed: conformed.ProductCategory does not exist.',&#xA;        1;&#xA;END;&#xA;&#xA;IF OBJECT_ID(N'meta.ProductCategoryLocalization', N'U') IS NULL&#xA;BEGIN&#xA;    THROW 51056,&#xA;        'Master preflight failed: product-category localization metadata does not exist.',&#xA;        1;&#xA;END;&#xA;&#xA;&#xA;/* ---------------------------------------------------------&#xA;   4. Critical input readiness&#xA;&#xA;   Do not destroy a valid warehouse if the load inputs are&#xA;   unexpectedly empty.&#xA;   --------------------------------------------------------- */&#xA;&#xA;IF NOT EXISTS (SELECT TOP (1) 1 FROM conformed.Geography)&#xA;   OR NOT EXISTS (SELECT TOP (1) 1 FROM conformed.Customer)&#xA;   OR NOT EXISTS (SELECT TOP (1) 1 FROM conformed.ProductCategory)&#xA;   OR NOT EXISTS (SELECT TOP (1) 1 FROM meta.ProductCategoryLocalization)&#xA;&#xA;   OR NOT EXISTS (SELECT TOP (1) 1 FROM stg.orders)&#xA;   OR NOT EXISTS (SELECT TOP (1) 1 FROM stg.order_items)&#xA;   OR NOT EXISTS (SELECT TOP (1) 1 FROM stg.products)&#xA;   OR NOT EXISTS (SELECT TOP (1) 1 FROM stg.customers)&#xA;   OR NOT EXISTS (SELECT TOP (1) 1 FROM stg.sellers)&#xA;   OR NOT EXISTS (SELECT TOP (1) 1 FROM stg.payments)&#xA;   OR NOT EXISTS (SELECT TOP (1) 1 FROM stg.reviews)&#xA;BEGIN&#xA;    THROW 51058,&#xA;        'Master preflight failed: one or more required load inputs are empty.',&#xA;        1;&#xA;END;&#xA;&#xA;&#xA;/* ---------------------------------------------------------&#xA;   5. Centralized warehouse DQ framework&#xA;&#xA;   Check all procedures before reset so a missing deployment&#xA;   is never discovered only after the warehouse is rebuilt.&#xA;   --------------------------------------------------------- */&#xA;&#xA;IF&#xA;(&#xA;    SELECT COUNT(*)&#xA;    FROM sys.procedures AS p&#xA;    INNER JOIN sys.schemas AS s&#xA;        ON p.schema_id = s.schema_id&#xA;    WHERE s.name = N'dq'&#xA;      AND p.name IN&#xA;      (&#xA;          N'usp_ValidateDimGeography',&#xA;          N'usp_ValidateDimCustomer',&#xA;          N'usp_ValidateDimSeller',&#xA;          N'usp_ValidateDimProductCategory',&#xA;          N'usp_ValidateDimProduct',&#xA;          N'usp_ValidateFactOrder',&#xA;          N'usp_ValidateFactOrderItem',&#xA;          N'usp_ValidateFactPayment',&#xA;          N'usp_ValidateFactReview',&#xA;          N'usp_ValidateWarehouse'&#xA;      )&#xA;) &lt;&gt; 10&#xA;BEGIN&#xA;    THROW 51059,&#xA;        'Master preflight failed: centralized warehouse DQ procedures are not fully deployed.',&#xA;        1;&#xA;END;&#xA;&#xA;&#xA;/* ---------------------------------------------------------&#xA;   6. DimDate coverage for every date role currently loaded&#xA;   into warehouse facts.&#xA;   --------------------------------------------------------- */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM&#xA;    (&#xA;        /* FactOrder */&#xA;        SELECT CAST(order_purchase_timestamp AS date) AS SourceDate&#xA;        FROM stg.orders&#xA;        WHERE order_purchase_timestamp IS NOT NULL&#xA;&#xA;        UNION&#xA;&#xA;        SELECT CAST(order_approved_at AS date)&#xA;        FROM stg.orders&#xA;        WHERE order_approved_at IS NOT NULL&#xA;&#xA;        UNION&#xA;&#xA;        SELECT CAST(order_delivered_carrier_date AS date)&#xA;        FROM stg.orders&#xA;        WHERE order_delivered_carrier_date IS NOT NULL&#xA;&#xA;        UNION&#xA;&#xA;        SELECT CAST(order_delivered_customer_date AS date)&#xA;        FROM stg.orders&#xA;        WHERE order_delivered_customer_date IS NOT NULL&#xA;&#xA;        UNION&#xA;&#xA;        SELECT CAST(order_estimated_delivery_date AS date)&#xA;        FROM stg.orders&#xA;        WHERE order_estimated_delivery_date IS NOT NULL&#xA;&#xA;        /* FactOrderItem */&#xA;        UNION&#xA;&#xA;        SELECT CAST(shipping_limit_date AS date)&#xA;        FROM stg.order_items&#xA;        WHERE shipping_limit_date IS NOT NULL&#xA;&#xA;        /* FactReview */&#xA;        UNION&#xA;&#xA;        SELECT CAST(review_creation_date AS date)&#xA;        FROM stg.reviews&#xA;        WHERE review_creation_date IS NOT NULL&#xA;&#xA;        UNION&#xA;&#xA;        SELECT CAST(review_answer_timestamp AS date)&#xA;        FROM stg.reviews&#xA;        WHERE review_answer_timestamp IS NOT NULL&#xA;&#xA;    ) AS sd&#xA;&#xA;    LEFT JOIN dwh.DimDate AS dd&#xA;        ON dd.DateKey =&#xA;           CONVERT(int, CONVERT(char(8), sd.SourceDate, 112))&#xA;&#xA;    WHERE dd.DateKey IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 51057,&#xA;        'Master preflight failed: one or more required source dates are missing from DimDate.',&#xA;        1;&#xA;END;&#xA;&#xA;&#xA;PRINT 'MASTER FULL-REFRESH PREFLIGHT PASSED.';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Reset DWH Full Refresh"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{33D7817D-0A23-405D-8CC9-18F7D86DD43C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Reset DWH Full Refresh"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{55243E60-4806-418B-9E2C-693FE1AB8592}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;IF DB_NAME() &lt;&gt; N'NOVA_Market'&#xA;BEGIN&#xA;    THROW 51040,&#xA;        'Full-refresh reset aborted: current database is not NOVA_Market.',&#xA;        1;&#xA;END;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    /* Facts */&#xA;    TRUNCATE TABLE dwh.FactReview;&#xA;    TRUNCATE TABLE dwh.FactPayment;&#xA;    TRUNCATE TABLE dwh.FactOrderItem;&#xA;    TRUNCATE TABLE dwh.FactOrder;&#xA;&#xA;    /* Child dimensions */&#xA;    DELETE FROM dwh.DimCustomer;&#xA;    DELETE FROM dwh.DimSeller;&#xA;    DELETE FROM dwh.DimProduct;&#xA;&#xA;    /* Parent dimensions */&#xA;    DELETE FROM dwh.DimGeography;&#xA;    DELETE FROM dwh.DimProductCategory;&#xA;&#xA;    /* Reset dimension identities */&#xA;    DBCC CHECKIDENT ('dwh.DimGeography', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimCustomer', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimSeller', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimProductCategory', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimProduct', RESEED, 0);&#xA;&#xA;    COMMIT TRANSACTION;&#xA;&#xA;    PRINT 'DWH FULL-REFRESH RESET COMPLETED SUCCESSFULLY.';&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF XACT_STATE() &lt;&gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Run Warehouse DQ"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FB404389-CEE2-4602-B35B-E36B3F33B64D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Run Warehouse DQ"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{55243E60-4806-418B-9E2C-693FE1AB8592}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;EXEC dq.usp_ValidateWarehouse;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Validate Dimension Load"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A66E2CA0-F362-41D7-89EA-052202E4DECA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Validate Dimension Load"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{55243E60-4806-418B-9E2C-693FE1AB8592}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;/* =========================================================&#xA;   DIMENSION LOAD COMPLETION GATE&#xA;   ========================================================= */&#xA;&#xA;IF (SELECT COUNT(*) FROM dwh.DimGeography WHERE GeographyKey = 0) &lt;&gt; 1&#xA;    THROW 51060, 'Dimension gate failed: invalid DimGeography Unknown member.', 1;&#xA;&#xA;IF (SELECT COUNT(*) FROM dwh.DimCustomer WHERE CustomerKey = 0) &lt;&gt; 1&#xA;    THROW 51061, 'Dimension gate failed: invalid DimCustomer Unknown member.', 1;&#xA;&#xA;IF (SELECT COUNT(*) FROM dwh.DimSeller WHERE SellerKey = 0) &lt;&gt; 1&#xA;    THROW 51062, 'Dimension gate failed: invalid DimSeller Unknown member.', 1;&#xA;&#xA;IF (SELECT COUNT(*) FROM dwh.DimProductCategory WHERE ProductCategoryKey = 0) &lt;&gt; 1&#xA;    THROW 51063, 'Dimension gate failed: invalid DimProductCategory Unknown member.', 1;&#xA;&#xA;IF (SELECT COUNT(*) FROM dwh.DimProduct WHERE ProductKey = 0) &lt;&gt; 1&#xA;    THROW 51064, 'Dimension gate failed: invalid DimProduct Unknown member.', 1;&#xA;&#xA;&#xA;/* Business-row completeness */&#xA;&#xA;IF (SELECT COUNT(*) FROM dwh.DimGeography WHERE GeographyKey &lt;&gt; 0)&#xA;   &lt;&gt; (SELECT COUNT(*) FROM conformed.Geography)&#xA;    THROW 51065, 'Dimension gate failed: DimGeography row count mismatch.', 1;&#xA;&#xA;IF (SELECT COUNT(*) FROM dwh.DimCustomer WHERE CustomerKey &lt;&gt; 0)&#xA;   &lt;&gt; (SELECT COUNT(*) FROM conformed.Customer)&#xA;    THROW 51066, 'Dimension gate failed: DimCustomer row count mismatch.', 1;&#xA;&#xA;IF (SELECT COUNT(*) FROM dwh.DimSeller WHERE SellerKey &lt;&gt; 0)&#xA;   &lt;&gt; (SELECT COUNT(*) FROM stg.sellers)&#xA;    THROW 51067, 'Dimension gate failed: DimSeller row count mismatch.', 1;&#xA;&#xA;IF (SELECT COUNT(*) FROM dwh.DimProductCategory WHERE ProductCategoryKey &lt;&gt; 0)&#xA;   &lt;&gt; (SELECT COUNT(*) FROM conformed.ProductCategory)&#xA;    THROW 51068, 'Dimension gate failed: DimProductCategory row count mismatch.', 1;&#xA;&#xA;IF (SELECT COUNT(*) FROM dwh.DimProduct WHERE ProductKey &lt;&gt; 0)&#xA;   &lt;&gt; (SELECT COUNT(*) FROM stg.products)&#xA;    THROW 51069, 'Dimension gate failed: DimProduct row count mismatch.', 1;&#xA;&#xA;&#xA;/* Physical dimension FK integrity */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimCustomer AS c&#xA;    LEFT JOIN dwh.DimGeography AS g&#xA;        ON c.RepresentativeGeographyKey = g.GeographyKey&#xA;    WHERE g.GeographyKey IS NULL&#xA;)&#xA;    THROW 51070, 'Dimension gate failed: invalid DimCustomer geography key.', 1;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimSeller AS s&#xA;    LEFT JOIN dwh.DimGeography AS g&#xA;        ON s.GeographyKey = g.GeographyKey&#xA;    WHERE g.GeographyKey IS NULL&#xA;)&#xA;    THROW 51071, 'Dimension gate failed: invalid DimSeller geography key.', 1;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimProduct AS p&#xA;    LEFT JOIN dwh.DimProductCategory AS pc&#xA;        ON p.ProductCategoryKey = pc.ProductCategoryKey&#xA;    WHERE pc.ProductCategoryKey IS NULL&#xA;)&#xA;    THROW 51072, 'Dimension gate failed: invalid DimProduct category key.', 1;&#xA;&#xA;PRINT 'DIMENSION LOAD GATE PASSED.';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Validate Fact Load"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{83358346-CC93-4E8B-BF40-267D3CF3840C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Validate Fact Load"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{55243E60-4806-418B-9E2C-693FE1AB8592}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;/* =========================================================&#xA;   FINAL FACT LOAD COMPLETION GATE&#xA;   ========================================================= */&#xA;&#xA;/* ---------------------------------------------------------&#xA;   Fact row-count completeness&#xA;   --------------------------------------------------------- */&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.FactOrder)&#xA;   &lt;&gt; (SELECT COUNT_BIG(*) FROM stg.orders)&#xA;BEGIN&#xA;    THROW 51080,&#xA;        'Fact gate failed: FactOrder row count does not match stg.orders.',&#xA;        1;&#xA;END;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.FactOrderItem)&#xA;   &lt;&gt; (SELECT COUNT_BIG(*) FROM stg.order_items)&#xA;BEGIN&#xA;    THROW 51081,&#xA;        'Fact gate failed: FactOrderItem row count does not match stg.order_items.',&#xA;        1;&#xA;END;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.FactPayment)&#xA;   &lt;&gt; (SELECT COUNT_BIG(*) FROM stg.payments)&#xA;BEGIN&#xA;    THROW 51082,&#xA;        'Fact gate failed: FactPayment row count does not match stg.payments.',&#xA;        1;&#xA;END;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.FactReview)&#xA;   &lt;&gt; (SELECT COUNT_BIG(*) FROM stg.reviews)&#xA;BEGIN&#xA;    THROW 51083,&#xA;        'Fact gate failed: FactReview row count does not match stg.reviews.',&#xA;        1;&#xA;END;&#xA;&#xA;&#xA;/* ---------------------------------------------------------&#xA;   FactOrder coverage for child facts&#xA;   --------------------------------------------------------- */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactOrderItem AS oi&#xA;    LEFT JOIN dwh.FactOrder AS o&#xA;        ON oi.OrderID = o.OrderID&#xA;    WHERE o.OrderID IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 51084,&#xA;        'Fact gate failed: FactOrderItem contains OrderID values missing from FactOrder.',&#xA;        1;&#xA;END;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactPayment AS p&#xA;    LEFT JOIN dwh.FactOrder AS o&#xA;        ON p.OrderID = o.OrderID&#xA;    WHERE o.OrderID IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 51085,&#xA;        'Fact gate failed: FactPayment contains OrderID values missing from FactOrder.',&#xA;        1;&#xA;END;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactReview AS r&#xA;    LEFT JOIN dwh.FactOrder AS o&#xA;        ON r.OrderID = o.OrderID&#xA;    WHERE o.OrderID IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 51086,&#xA;        'Fact gate failed: FactReview contains OrderID values missing from FactOrder.',&#xA;        1;&#xA;END;&#xA;&#xA;&#xA;/* ---------------------------------------------------------&#xA;   Fact additive row counters&#xA;   --------------------------------------------------------- */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactOrder&#xA;    WHERE OrderCount &lt;&gt; 1&#xA;)&#xA;    THROW 51087, 'Fact gate failed: invalid FactOrder OrderCount.', 1;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactOrderItem&#xA;    WHERE OrderItemCount &lt;&gt; 1&#xA;)&#xA;    THROW 51088, 'Fact gate failed: invalid FactOrderItem OrderItemCount.', 1;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactPayment&#xA;    WHERE PaymentCount &lt;&gt; 1&#xA;)&#xA;    THROW 51089, 'Fact gate failed: invalid FactPayment PaymentCount.', 1;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactReview&#xA;    WHERE ReviewCount &lt;&gt; 1&#xA;)&#xA;    THROW 51090, 'Fact gate failed: invalid FactReview ReviewCount.', 1;&#xA;&#xA;&#xA;/* ---------------------------------------------------------&#xA;   Final physical dimension FK state&#xA;   --------------------------------------------------------- */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM sys.foreign_keys&#xA;    WHERE parent_object_id IN&#xA;    (&#xA;        OBJECT_ID(N'dwh.DimCustomer'),&#xA;        OBJECT_ID(N'dwh.DimSeller'),&#xA;        OBJECT_ID(N'dwh.DimProduct')&#xA;    )&#xA;      AND (is_disabled = 1 OR is_not_trusted = 1)&#xA;)&#xA;BEGIN&#xA;    THROW 51091,&#xA;        'Fact gate failed: one or more DWH dimension foreign keys are disabled or untrusted.',&#xA;        1;&#xA;END;&#xA;&#xA;PRINT 'FINAL FACT LOAD GATE PASSED.';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
