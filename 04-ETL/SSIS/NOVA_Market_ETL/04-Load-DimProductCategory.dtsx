      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{55243E60-4806-418B-9E2C-693FE1AB8592}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimProductCategory&#xA;    WHERE ProductCategoryKey &lt;&gt; 0&#xA;)&#xA;BEGIN&#xA;    THROW 51044, 'DimProductCategory load aborted: business rows already exist. Run the centralized full-refresh reset first.', 1;&#xA;END;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimProductCategory&#xA;    WHERE ProductCategoryKey = 0&#xA;)&#xA;BEGIN&#xA;    DELETE FROM dwh.DimProductCategory&#xA;    WHERE ProductCategoryKey = 0;&#xA;END;&#xA;&#xA;SET IDENTITY_INSERT dwh.DimProductCategory ON;&#xA;&#xA;INSERT INTO dwh.DimProductCategory&#xA;(&#xA;    ProductCategoryKey,&#xA;    SourceCategoryName,&#xA;    EnglishCategoryName,&#xA;    PersianCategoryName,&#xA;    MissingEnglishTranslationFlag,&#xA;    MissingPersianLocalizationFlag&#xA;)&#xA;VALUES&#xA;(&#xA;    0,&#xA;    NULL,&#xA;    'Unknown',&#xA;    N'نامشخص',&#xA;    0,&#xA;    0&#xA;);&#xA;&#xA;SET IDENTITY_INSERT dwh.DimProductCategory OFF;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
