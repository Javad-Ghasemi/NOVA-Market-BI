                    <outputColumn
                      refId="Package\DFT - Load FactOrderItem\SRC - Order Items.Outputs[OLE DB Source Output].Columns[CustomerUniqueID]"
                      dataType="wstr"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
