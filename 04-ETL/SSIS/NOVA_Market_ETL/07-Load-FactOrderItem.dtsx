                    <outputColumn
                      refId="Package\DFT - Load FactOrderItem\SRC - Order Items.Outputs[OLE DB Source Output].Columns[OrderItemID]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\DFT - Load FactOrderItem\SRC - Order Items.Outputs[OLE DB Source Output].ExternalColumns[OrderItemID]"
                      lineageId="Package\DFT - Load FactOrderItem\SRC - Order Items.Outputs[OLE DB Source Output].Columns[OrderItemID]"
                      name="OrderItemID"
